+            VALUES (?,?,'active','2026-10-26T00:00:00Z','2026-10-26T00:00:00Z')''',(rid,pid))
+    library=SourceLibrary(base_storage_dir=tmp_path/'sources')
+    texts={'support':'Grant terms\n'+STATEMENT+'\n', 'contradiction':COUNTER+'\n',
