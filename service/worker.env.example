# ==============================================================================
# Qwen Collective — VPS Worker Environment Configuration Template
# ==============================================================================
# Location on Linux VPS: /etc/qwen-collective/worker.env
# Permissions: chmod 0600 /etc/qwen-collective/worker.env
# Ownership  : chown qwen-worker:qwen-worker /etc/qwen-collective/worker.env
# ==============================================================================

# Operational Environment (enforces strict production security gates)
QC_ENV=production

# Controller URL (Tailscale HTTPS endpoint, never exposed to public internet)
QC_CONTROLLER_URL=https://desktop-44h6qvp.tailb5d90b.ts.net

# Worker Identity
QC_WORKER_ID=qwen-vps
QC_WORKER_NAME=Qwen VPS Execution Worker
QC_WORKER_ROLE=vps_worker

# Storage Paths
QC_WORKER_DATA_DIR=/opt/qwen-collective/data
QC_WORKER_TOKEN_FILE=/opt/qwen-collective/data/worker_token.json

# Polling and Heartbeat Cadence (seconds)
QC_POLL_INTERVAL=5
QC_HEARTBEAT_INTERVAL=15
QC_LEASE_DURATION=300
QC_TASK_TIMEOUT=600

# Logging Level (DEBUG, INFO, WARNING, ERROR)
QC_LOG_LEVEL=INFO

# ==============================================================================
# Initial Enrollment Credential (ONE-TIME USE ONLY)
# ==============================================================================
# When provisioning a new worker node, provide the single-use enrollment token
# created on the controller below. After first successful registration, the
# daemon will automatically persist the issued worker Bearer token to
# /opt/qwen-collective/data/worker_token.json and comment out this line.
#
# QC_ENROLLMENT_TOKEN=qcwe_your_one_time_enrollment_token_here
